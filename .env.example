# Criba environment configuration
# Copy to .env and adjust the values. Used by docker compose services.

# PostgreSQL (must match the postgres service in docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://criba:criba_dev@postgres:5432/criba
SYNC_DATABASE_URL=postgresql://criba:criba_dev@postgres:5432/criba

# Redis
REDIS_URL=redis://redis:6379/0

# API authentication (optional)
# When set, every API route requires the X-API-Key header and the dashboard
# WebSocket connects with ?api_key=. The dashboard image is built with the
# same key, so keep the name CRIBA_API_KEY for the compose interpolation.
# CRIBA_API_KEY=change-me

# API CORS (optional)
# Comma-separated allowed dashboard origins. Defaults cover the compose
# dashboard (http://localhost:3030) and the Next.js dev server
# (http://localhost:3000).
# CRIBA_CORS_ORIGINS=http://localhost:3030,http://localhost:3000

# Ollama (optional)
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_TIMEOUT=60

# Telegram plugin (optional)
# Create the session once on the host with:
#   TELEGRAM_API_ID=... TELEGRAM_API_HASH=... TELEGRAM_PHONE=+57... criba login telegram
# (TELEGRAM_CODE can be preset to skip the interactive code prompt.)
# The resulting telegram_session.session file is mounted into the worker.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=
# TELEGRAM_CODE=
# TELEGRAM_SESSION_PATH=/app/telegram_session

# Bluesky plugin (optional)
# The first poll logs in with the app password and stores the session string
# at BLUESKY_SESSION_PATH; later runs restore it instead of logging in again.
# Mount the file into the worker (like the Telegram session) to keep it
# across container recreations.
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# BLUESKY_SESSION_PATH=bluesky_session.string

# YouTube plugin (optional)
# YOUTUBE_API_KEY=
